        "**/node_modules/**"
      ],
    },
    {
      "name": "酒場ページのみデバッグ (Edge)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:8000",
      "disableNetworkCache": true,
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceFolder}",
      "timeout": 100000,
      "sourceMapPathOverrides": {
        "src://tavern_helper_template/*": "${workspaceFolder}/*",
